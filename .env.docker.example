# Copy to .env.docker and replace these local-only placeholder passwords.
# Use URL-safe values because the application DSNs are assembled by Compose.
POSTGRES_DB=enterprise_analytics
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=local_admin_change_me
POSTGRES_APP_USER=eca_app
POSTGRES_APP_PASSWORD=local_app_change_me
POSTGRES_READER_USER=eca_reader
POSTGRES_READER_PASSWORD=local_reader_change_me

FRONTEND_PORT=5173
BACKEND_PORT=8000

# Optional local OpenTelemetry overlay settings (no AWS export).
OTEL_COLLECTOR_PORT=4318
