APP_NAME=Enterprise Conversational Analytics Assistant
APP_ENV=development
AUTH_MODE=development
AUTH_DEV_SUBJECT=dev-user
AUTH_DEV_EMAIL=developer@example.invalid
AUTH_DEV_DISPLAY_NAME=Local Developer
AUTH_DEV_ROLES=analyst
AUTH_OIDC_ISSUER=
AUTH_OIDC_AUDIENCE=
AUTH_OIDC_CLIENT_ID=
AUTH_OIDC_CLIENT_ID_CLAIM=aud
AUTH_OIDC_JWKS_URL=
AUTH_OIDC_ALGORITHMS=RS256
AUTH_OIDC_ROLES_CLAIM=roles
AUTH_OIDC_GROUPS_CLAIM=groups
AUTH_OIDC_SCOPE_CLAIM=scope
AUTH_OIDC_EMAIL_CLAIM=email
AUTH_OIDC_DISPLAY_NAME_CLAIM=name
AUTH_OIDC_TOKEN_USE=
AUTH_GROUP_ROLE_MAPPING={}
APP_HOST=127.0.0.1
APP_PORT=8000
LOG_LEVEL=INFO
LOG_FORMAT=console
OBSERVABILITY_ENABLED=false
SERVICE_NAME=enterprise-conversational-analytics-backend
SERVICE_VERSION=0.1.0
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACE_SAMPLE_RATIO=0.10
OTEL_EXPORT_TIMEOUT_SECONDS=5
METRICS_ENABLED=true
TRACING_ENABLED=true
CORS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
CORS_ALLOW_CREDENTIALS=true
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
REQUEST_MAX_BODY_BYTES=65536
SECURITY_HEADERS_ENABLED=true
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
API_DOCS_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_KEY_PREFIX=eca:rate
DATABASE_URL=postgresql+psycopg://analytics_user:replace_with_local_password@localhost:5432/enterprise_analytics
TEST_DATABASE_URL=postgresql+psycopg://analytics_test_user:replace_with_local_test_password@localhost:5432/enterprise_analytics_test
QUERY_DATABASE_URL=postgresql+psycopg://eca_reader:replace_with_local_reader_password@localhost:5432/enterprise_analytics
QUERY_TEST_DATABASE_URL=postgresql+psycopg://eca_test_reader:replace_with_local_test_reader_password@localhost:5432/enterprise_analytics_test
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_POOL_TIMEOUT_SECONDS=5
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_POOL_RECYCLE_SECONDS=1800
QUERY_MAX_ROWS=500
QUERY_TIMEOUT_MS=5000
DASHBOARD_TOP_N=10
EVAL_RANDOM_SEED=42
SQL_RESULT_SUMMARY_MAX_ROWS=50
SQL_RESULT_SUMMARY_MAX_CHARS=12000
KNOWLEDGE_CATALOG_DIR=backend/data/knowledge_catalog
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=your-embedding-deployment-name
EMBEDDING_DIMENSIONS=1536
KNOWLEDGE_HIERARCHY_MAX_DEPTH=4
KNOWLEDGE_HIERARCHY_MAX_BRANCHES=3
KNOWLEDGE_HIERARCHY_MIN_CONFIDENCE=0.60
KNOWLEDGE_CATALOG_TOP_K=6
KNOWLEDGE_CHUNK_SIZE_CHARS=1200
KNOWLEDGE_CHUNK_OVERLAP_CHARS=150
KNOWLEDGE_CONTEXT_MAX_CHARS=12000
KNOWLEDGE_RERANK_ENABLED=false
DATA_DISCOVERY_TOP_K=5
DATA_QUALITY_DIR=backend/data/data_quality
DATA_QUALITY_TOP_K=5
SEMANTICA_CHUNK_SIZE_CHARS=900
SEMANTICA_CHUNK_OVERLAP_CHARS=120
SEMANTICA_SEED_TOP_K=4
SEMANTICA_MAX_HOPS=2
SEMANTICA_MAX_EVIDENCE=12
LLM_PROVIDER=gemini
GEMINI_LLM_MODEL=gemini-3.8-flash
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=replace_me
AZURE_OPENAI_DEPLOYMENT=your-deployment-name
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_TIMEOUT_SECONDS=30
LLM_OPERATION_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=2
LLM_RETRY_INITIAL_DELAY_SECONDS=0.5
LLM_RETRY_MAX_DELAY_SECONDS=8
LLM_RETRY_MAX_TOTAL_DELAY_SECONDS=15
LLM_RETRY_JITTER_RATIO=0.20
LLM_CIRCUIT_BREAKER_ENABLED=true
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_RECOVERY_TIMEOUT_SECONDS=30
LLM_CIRCUIT_HALF_OPEN_MAX_CALLS=1
LLM_FALLBACK_PROVIDER=none
LLM_MAX_OUTPUT_TOKENS=2000
INTENT_ROUTER_MIN_CONFIDENCE=0.60
NLP2SQL_MAX_DOMAINS=3
NLP2SQL_MAX_TABLES=5
NLP2SQL_ACCEPT_SCORE=0.80
NLP2SQL_REWRITE_SCORE=0.50
NLP2SQL_MAX_REWRITES=1
FORECAST_DEFAULT_HORIZON=3
FORECAST_MAX_HORIZON=12
FORECAST_MIN_HISTORY_POINTS=8
FORECAST_MAX_HISTORY_POINTS=120
FORECAST_BACKTEST_POINTS=4
FORECAST_MOVING_AVERAGE_WINDOW=3
FORECAST_INTERVAL_Z=1.96
ARTIFACTS_OUTPUT_DIR=backend/artifacts
SESSION_COOKIE_NAME=eca_session_id
SESSION_MAX_AGE_SECONDS=86400
SESSION_COOKIE_SECURE=false
SESSION_STORE_BACKEND=json
SESSION_REDIS_URL=
